local function teleportToNearestFarmItem(itemName, searchTerms)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local items = findFarmItems(searchTerms)
    
    if itemName == "Yarn Ball" and #items == 0 then
        items = findYarnBallByRedX()
    end
    
    if #items > 0 then
        local nearestItem = nil
        local nearestDistance = math.huge
        
        for _, item in ipairs(items) do
            if item and item.Position then
                local distance = (item.Position - root.Position).Magnitude
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestItem = item
                end
            end
        end
        
        if nearestItem then
            root.CFrame = CFrame.new(nearestItem.Position + Vector3.new(0, 5, 0))
            showNotification("✅ Đã teleport đến " .. itemName .. "!")
            
            -- Tự động giữ nút E để nhặt
            task.spawn(function()
                pickupItem()
            end)
            
            return true
        end
    end
    
    showNotification("❌ Không tìm thấy " .. itemName .. " trong map!")
    return false
end

