local function clearESP()
    for item, espData in pairs(espCache) do
        pcall(function()
            if espData.Highlight then espData.Highlight:Destroy() end
            if espData.Billboard then espData.Billboard:Destroy() end
        end)
    end
    espCache = {}
end

local function applyPlayerESP(player)
    pcall(function()
        local char = player.Character
        if not char then return end
        local head = char:FindFirstChild("Head")
        if not head then return end
        if head:FindFirstChild("PlayerESP") then return end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "PlayerESP_Highlight"
        highlight.FillColor = Color3.fromRGB(255, 100, 100)
        highlight.FillTransparency = 0.7
        highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineTransparency = 0
        highlight.Parent = char
        
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "PlayerESP"
        billboard.Size = UDim2.new(0, 200, 0, 35)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = head
        
        local nameLabel = Instance.new("TextLabel", billboard)
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = "👤 " .. player.Name
        nameLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        nameLabel.Font = Enum.Font.GothamBlack
        nameLabel.TextSize = 14
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    end)
end

local function applyPetESP(pet, isRare)
    pcall(function()
        if not pet then return end
        
        local name = pet.Name:lower()
        local parentName = pet.Parent and pet.Parent.Name:lower() or ""
        
        local petType = "NORMAL"
        local petColor = Color3.fromRGB(150, 255, 150)
        
        if isRare then
            if name:find("mythic") or name:find("mythical") or parentName:find("mythic") then
                petType = "MYTHICAL"
                petColor = Color3.fromRGB(255, 0, 255)
            elseif name:find("divine") or parentName:find("divine") then
                petType = "DIVINE"
                petColor = Color3.fromRGB(255, 215, 0)
            elseif name:find("boss") or parentName:find("boss") then
                petType = "BOSS"
                petColor = Color3.fromRGB(255, 50, 50)
            elseif name:find("secret") or parentName:find("secret") then
                petType = "SECRET"
                petColor = Color3.fromRGB(255, 105, 180)
            elseif name:find("legendary") or parentName:find("legendary") then
                petType = "LEGENDARY"
                petColor = Color3.fromRGB(255, 165, 0)
            else
                return
            end
        end
        
        if espCache[pet] then return end
        
        local part = pet:IsA("Model") and (pet.PrimaryPart or pet:FindFirstChildOfClass("BasePart")) or pet
        if not part then return end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "PetESP_Highlight"
        highlight.FillColor = petColor
        highlight.FillTransparency = 0.7
        highlight.OutlineColor = petColor
        highlight.OutlineTransparency = 0
        highlight.Parent = pet
        
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "PetESP"
        billboard.Size = UDim2.new(0, 220, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = part
        
        local nameLabel = Instance.new("TextLabel", billboard)
        nameLabel.Size = UDim2.new(1, 0, 0.6, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = "🐾 " .. pet.Name
        nameLabel.TextColor3 = petColor
        nameLabel.Font = Enum.Font.GothamBlack
        nameLabel.TextSize = 13
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        
        local typeLabel = Instance.new("TextLabel", billboard)
        typeLabel.Size = UDim2.new(1, 0, 0.4, 0)
        typeLabel.Position = UDim2.new(0, 0, 0.6, 0)
        typeLabel.BackgroundTransparency = 1
        typeLabel.Text = "[" .. petType .. "]"
        typeLabel.TextColor3 = petColor
        typeLabel.Font = Enum.Font.GothamBold
        typeLabel.TextSize = 11
        typeLabel.TextStrokeTransparency = 0
        typeLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        
        espCache[pet] = {Highlight = highlight, Billboard = billboard, Type = petType}
    end)
end

