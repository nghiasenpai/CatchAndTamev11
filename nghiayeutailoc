AddSection("🏝️ BAY ĐẾN ĐẢO")

local islandFlySpeed = 250 * SPEED_MULTIPLIER
local isFlyingToIsland = false
local currentFlyTween = nil

local function findIslandByName(islandName)
    local searchName = islandName:lower()
    local foundPositions = {}
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        pcall(function()
            if obj.Name:lower():find(searchName) or (obj.Parent and obj.Parent.Name:lower():find(searchName)) then
                if obj:IsA("BasePart") then
                    table.insert(foundPositions, obj.Position)
                elseif obj:IsA("Model") then
                    local primaryPart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("BasePart")
                    if primaryPart then
                        table.insert(foundPositions, primaryPart.Position)
                    end
                end
            end
        end)
    end
    
    if #foundPositions > 0 then
        local centerPos = Vector3.new(0, 0, 0)
        for _, pos in ipairs(foundPositions) do
            centerPos = centerPos + pos
        end
        centerPos = centerPos / #foundPositions
        return centerPos
    end
    return nil
end

local function findIslandByBillboard(islandName)
    local searchName = islandName:lower()
    local foundPositions = {}
    
    for _, gui in ipairs(workspace:GetDescendants()) do
        if gui:IsA("BillboardGui") or gui:IsA("SurfaceGui") then
            pcall(function()
                local guiText = ""
                for _, child in ipairs(gui:GetDescendants()) do
                    if child:IsA("TextLabel") or child:IsA("TextButton") then
                        guiText = guiText .. " " .. child.Text
                    end
                end
                
                if guiText:lower():find(searchName) then
                    local parentModel = gui.Parent
                    if parentModel and parentModel:IsA("Model") then
                        local primaryPart = parentModel.PrimaryPart or parentModel:FindFirstChildOfClass("BasePart")
                        if primaryPart then
                            table.insert(foundPositions, primaryPart.Position)
                        end
                    else
                        local guiParent = gui.Parent
                        if guiParent and guiParent:IsA("BasePart") then
                            table.insert(foundPositions, guiParent.Position)
                        end
                    end
                end
            end)
        end
    end
    
    if #foundPositions > 0 then
        local centerPos = Vector3.new(0, 0, 0)
        for _, pos in ipairs(foundPositions) do
            centerPos = centerPos + pos
        end
        centerPos = centerPos / #foundPositions
        return centerPos
    end
    return nil
end

local function findIslandByModelName(islandName)
    local searchNames = {}
    local baseName = islandName:lower():gsub(" island", ""):gsub("island", "")
    
    table.insert(searchNames, islandName:lower())
    table.insert(searchNames, baseName)
    table.insert(searchNames, baseName .. " island")
    table.insert(searchNames, baseName .. "island")
    table.insert(searchNames, baseName:gsub(" ", ""))
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local objName = obj.Name:lower()
            for _, searchName in ipairs(searchNames) do
                if objName:find(searchName) then
                    local primaryPart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("BasePart")
                    if primaryPart then
                        return primaryPart.Position
                    end
                end
            end
        end
    end
    return nil
end

local function findIslandSmart(islandName)
    local pos1 = findIslandByBillboard(islandName)
    if pos1 then return pos1 end
    
    local pos2 = findIslandByName(islandName)
    if pos2 then return pos2 end
    
    local pos3 = findIslandByModelName(islandName)
    if pos3 then return pos3 end
    
    return nil
end

local function findGroundPosition(targetPos)
    local rayOrigin = targetPos + Vector3.new(0, 100, 0)
    local rayDirection = Vector3.new(0, -500, 0)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    
    local raycastResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
    
    if raycastResult then
        return Vector3.new(targetPos.X, raycastResult.Position.Y, targetPos.Z)
    else
        return targetPos
    end
end

local function stopFlying()
    isFlyingToIsland = false
    if currentFlyTween then
        currentFlyTween:Cancel()
        currentFlyTween = nil
    end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = false
    end
end

local function flyToPosition(targetPosition)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not root or not hum then return end
    
    stopFlying()
    isFlyingToIsland = true
    hum.PlatformStand = true
    
    local finalGroundPos = findGroundPosition(targetPosition)
    
    local startPos = root.Position
    local flyHeight = math.max(startPos.Y, finalGroundPos.Y) + 150
    local highPoint = Vector3.new(startPos.X, flyHeight, startPos.Z)
    local targetHigh = Vector3.new(finalGroundPos.X, flyHeight, finalGroundPos.Z)
    local finalPos = Vector3.new(finalGroundPos.X, finalGroundPos.Y + 3, finalGroundPos.Z)
    
    local tween1 = TweenService:Create(root, TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = CFrame.new(highPoint)})
    tween1:Play()
    
    tween1.Completed:Connect(function()
        if not isFlyingToIsland then return end
        
        local distance = (targetHigh - highPoint).Magnitude
        local duration = math.clamp(distance / islandFlySpeed, 2, 6)
        
        local tween2 = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetHigh)})
        tween2:Play()
        
        tween2.Completed:Connect(function()
            if not isFlyingToIsland then return end
            
            local tween3 = TweenService:Create(root, TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {CFrame = CFrame.new(finalPos)})
            tween3:Play()
            
            tween3.Completed:Connect(function()
                if not isFlyingToIsland then return end
                
                stopFlying()
                
                task.wait(0.5)
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local finalRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    finalRoot.CFrame = CFrame.new(finalPos)
                    finalRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    
                    local finalHum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if finalHum then
                        finalHum.PlatformStand = false
                    end
                end
            end)
        end)
    end)
end

