-- ==========================================
-- HÀM BAY MƯỢT MÀ
-- ==========================================
local function stopFlying()
    isFlyingToIsland = false
    if currentFlyTween then
        pcall(function() currentFlyTween:Cancel() end)
        currentFlyTween = nil
    end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = false
    end
end

local function flyToExactPosition(targetPos, islandName)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    
    stopFlying()
    task.wait(0.1)
    
    isFlyingToIsland = true
    hum.PlatformStand = true
    
    local startPos = root.Position
    local flyHeight = math.max(startPos.Y, targetPos.Y) + config.islandFlyHeight
    
    -- Tạo waypoints
    local waypoints = {}
    local numPoints = 8
    
    table.insert(waypoints, Vector3.new(startPos.X, flyHeight, startPos.Z))
    
    for i = 1, numPoints do
        local alpha = i / numPoints
        local x = startPos.X + (targetPos.X - startPos.X) * alpha
        local z = startPos.Z + (targetPos.Z - startPos.Z) * alpha
        table.insert(waypoints, Vector3.new(x, flyHeight, z))
    end
    
    table.insert(waypoints, Vector3.new(targetPos.X, targetPos.Y + 5, targetPos.Z))
    
    showNotification("🚁 Đang bay đến " .. islandName .. "...")
    
    local currentIndex = 1
    
    local function moveToNextWaypoint()
        if not isFlyingToIsland then return end
        if currentIndex > #waypoints then
            isFlyingToIsland = false
            hum.PlatformStand = false
            root.CFrame = CFrame.new(targetPos.X, targetPos.Y + 5, targetPos.Z)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            showNotification("✅ Đã đến " .. islandName .. "!")
            return
        end
        
        local waypoint = waypoints[currentIndex]
        local currentPos = root.Position
        local distance = (waypoint - currentPos).Magnitude
        
        if distance < 5 then
            currentIndex = currentIndex + 1
            moveToNextWaypoint()
            return
        end
        
        local speed = config.islandFlySpeed
        local duration = math.clamp(distance / speed, 0.1, 2)
        
        local tween = TweenService:Create(
            root,
            TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
            {CFrame = CFrame.new(waypoint)}
        )
        currentFlyTween = tween
        tween:Play()
        
        tween.Completed:Connect(function()
            if not isFlyingToIsland then return end
            currentIndex = currentIndex + 1
            moveToNextWaypoint()
        end)
    end
    
    moveToNextWaypoint()
    
    task.delay(15, function()
        if isFlyingToIsland then
            stopFlying()
            root.CFrame = CFrame.new(targetPos.X, targetPos.Y + 5, targetPos.Z)
            showNotification("⚠️ Bay timeout - đã teleport trực tiếp!")
        end
    end)
end

