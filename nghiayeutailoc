local autoClicker = false

local autoClickToggle = AddToggle("🖱️ Auto Click (Ấn Y)", function(state)
    autoClicker = state
    showNotification(state and "✅ Đã bật Auto Click!" or "❌ Đã tắt Auto Click!")
    if state then
        task.spawn(function()
            while autoClicker do
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end)
                task.wait(config.autoClickInterval)
            end
        end)
    end
end)

AddInput("⚙️ Tốc Độ Auto Click:", config.autoClickInterval, function(v)
    config.autoClickInterval = v
    showNotification("✅ Tốc độ auto click: " .. v)
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.Y then
        autoClickToggle.SetState(not autoClickToggle.GetState())
    end
end)

