local function bypassTeleport(targetPos, name)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not root or not hum then return end
    
    stopFlying()
    task.wait(0.05)
    
    showNotification("⚡ Bypass TP đến " .. name .. "...")
    
    local oldCFrame = root.CFrame
    local finalPos = Vector3.new(targetPos.X, targetPos.Y + 5, targetPos.Z)
    
    root.CFrame = CFrame.new(root.Position + Vector3.new(0, 500, 0))
    task.wait(0.1)
    
    root.CFrame = CFrame.new(finalPos)
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    
    task.wait(0.15)
    
    local distanceMoved = (root.Position - oldCFrame.Position).Magnitude
    local expectedDistance = (oldCFrame.Position - finalPos).Magnitude
    
    if expectedDistance > 50 and distanceMoved < expectedDistance * 0.5 then
        task.wait(0.1)
        root.CFrame = CFrame.new(finalPos + Vector3.new(0, 2, 0))
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        task.wait(0.15)
    end
    
    task.wait(0.2)
    
    local finalDistance = (root.Position - finalPos).Magnitude
    if finalDistance < 20 then
        showNotification("✅ Đã đến " .. name .. "!")
    else
        root.CFrame = CFrame.new(finalPos)
        task.wait(0.1)
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        showNotification("⚠️thử lại " .. name)
    end
end

local function smoothFlyToPosition(targetPos, name)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not root or not hum then return end
    
    stopFlying()
    task.wait(0.1)
    
    isFlyingToIsland = true
    hum.PlatformStand = true
    
    showNotification("🕊️ Đang bay đến " .. name .. "...")
    
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.P = 1250
    bodyVelocity.Parent = root
    
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(100000, 100000, 100000)
    bodyGyro.D = 500
    bodyGyro.P = 100000
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root
    
    local startPos = root.Position
    local flyHeight = math.max(startPos.Y, targetPos.Y) + config.islandFlyHeight
    
    local phase = "UP"
    local flySpeed = config.islandFlySpeed
    
    local flyConn
    flyConn = RunService.RenderStepped:Connect(function(dt)
        if not isFlyingToIsland then
            if flyConn then flyConn:Disconnect() end
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            return
        end
        
        pcall(function()
            local currentRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not currentRoot then return end
            
            local currentPos = currentRoot.Position
            local cam = workspace.CurrentCamera
            
            bodyGyro.CFrame = CFrame.new(currentPos, currentPos + cam.CFrame.LookVector)
            
            if phase == "UP" then
                local heightDiff = flyHeight - currentPos.Y
                if heightDiff > 5 then
                    bodyVelocity.Velocity = Vector3.new(0, flySpeed, 0)
                else
                    phase = "HORIZONTAL"
                end
            elseif phase == "HORIZONTAL" then
                local horizontalTarget = Vector3.new(targetPos.X, flyHeight, targetPos.Z)
                local horizontalDiff = horizontalTarget - currentPos
                local horizontalDist = Vector3.new(horizontalDiff.X, 0, horizontalDiff.Z).Magnitude
                
                if horizontalDist > 10 then
                    local direction = Vector3.new(horizontalDiff.X, 0, horizontalDiff.Z).Unit
                    bodyVelocity.Velocity = direction * flySpeed
                    
                    local yDiff = flyHeight - currentPos.Y
                    bodyVelocity.Velocity = bodyVelocity.Velocity + Vector3.new(0, yDiff * 3, 0)
                else
                    phase = "DOWN"
                end
            elseif phase == "DOWN" then
                local targetY = targetPos.Y + 5
                local yDiff = targetY - currentPos.Y
                
                if yDiff < -5 then
                    bodyVelocity.Velocity = Vector3.new(0, -flySpeed * 0.6, 0)
                else
                    isFlyingToIsland = false
                    
                    if flyConn then flyConn:Disconnect() end
                    if bodyVelocity then bodyVelocity:Destroy() end
                    if bodyGyro then bodyGyro:Destroy() end
                    
                    hum.PlatformStand = false
                    currentRoot.CFrame = CFrame.new(targetPos.X, targetPos.Y + 5, targetPos.Z)
                    currentRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    
                    showNotification("✅ Đã đến " .. name .. "!")
                end
            end
        end)
    end)
    
    task.delay(20, function()
        if isFlyingToIsland then
            stopFlying()
            if flyConn then flyConn:Disconnect() end
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            
            local currentRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if currentRoot then
                currentRoot.CFrame = CFrame.new(targetPos.X, targetPos.Y + 5, targetPos.Z)
            end
            showNotification("⚠️timeout!")
        end
    end)
end

local function flyToPosition(targetPos, name)
    if BYPASS_TP then
        bypassTeleport(targetPos, name)
    else
        smoothFlyToPosition(targetPos, name)
    end
end

