task.spawn(function()
    local duration = 5
    local startTime = os.clock()
    
    while true do
        local elapsed = os.clock() - startTime
        local percent = math.clamp(elapsed / duration * 100, 0, 100)
        
        percentLabel.Text = math.floor(percent) .. "%"
        progressFill.Size = UDim2.new(percent / 100, 0, 1, 0)
        
        if percent < 20 then
            statusLabel.Text = "Đang tải hệ thống..."
        elseif percent < 40 then
            statusLabel.Text = "Đang tải chức năng..."
        elseif percent < 60 then
            statusLabel.Text = "Đang kết nối server..."
        elseif percent < 80 then
            statusLabel.Text = "Đang khởi tạo menu..."
        elseif percent < 100 then
            statusLabel.Text = "Hoàn tất..."
        end
        
        if percent >= 100 then break end
        task.wait(0.05)
    end
    
    percentLabel.Text = "100%"
    statusLabel.Text = "✅ KÍCH HOẠT THÀNH CÔNG!"
    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    progressFill.Size = UDim2.new(1, 0, 1, 0)
    
    task.wait(0.5)
    LoadingOverlay:Destroy()
    MainFrame.Visible = true
    
    if #tabs > 0 then
        tabs[1].Button.MouseButton1Click:Fire()
    end
end)

