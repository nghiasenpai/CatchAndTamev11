local antiCheckEnabled = true

local function setupAntiCheck()
    if not antiCheckEnabled then return end
    
    pcall(function()
        if syn and syn.protect_gui then
            syn.protect_gui(ScreenGui)
        end
    end)
    
    pcall(function()
        if ScreenGui.Parent == CoreGui then
            ScreenGui.Name = "UI_" .. math.random(1000000, 9999999)
        end
    end)
    
    pcall(function()
        if getnilinstances then
            local oldGetNilInstances = getnilinstances
            getnilinstances = function()
                local instances = oldGetNilInstances()
                local filtered = {}
                for _, inst in pairs(instances) do
                    if inst ~= ScreenGui and inst ~= MainFrame and inst ~= Container then
                        table.insert(filtered, inst)
                    end
                end
                return filtered
            end
        end
    end)
end

