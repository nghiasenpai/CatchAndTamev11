-- Hàm tìm Yarn Ball bằng cách nhận diện dấu X đỏ
local function findYarnBallByRedX()
    local foundItems = {}
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("BasePart") then
                if obj.Color and obj.Color.R > 0.7 and obj.Color.G < 0.3 and obj.Color.B < 0.3 then
                    if obj.Size.Magnitude < 10 then
                        table.insert(foundItems, obj)
                    end
                end
            elseif obj:IsA("Model") then
                local hasRedPart = false
                local primaryPart = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                
                for _, child in ipairs(obj:GetDescendants()) do
                    if child:IsA("BasePart") and child.Color and child.Color.R > 0.7 and child.Color.G < 0.3 and child.Color.B < 0.3 then
                        hasRedPart = true
                        primaryPart = child
                        break
                    end
                end
                
                if hasRedPart and primaryPart then
                    table.insert(foundItems, primaryPart)
                end
            end
        end)
    end
    
    return foundItems
end

local function findFarmItems(searchTerms)
    local foundItems = {}
    local foundMap = {}
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        pcall(function()
            local objName = obj.Name:lower()
            local parentName = obj.Parent and obj.Parent.Name:lower() or ""
            
            for _, term in ipairs(searchTerms) do
                local termLower = term:lower()
                
                if objName:find(termLower) or parentName:find(termLower) then
                    if obj:IsA("Model") then
                        local primaryPart = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                        if primaryPart and not foundMap[primaryPart] then
                            foundMap[primaryPart] = true
                            table.insert(foundItems, primaryPart)
                        end
                    elseif obj:IsA("BasePart") then
                        if not foundMap[obj] then
                            foundMap[obj] = true
                            table.insert(foundItems, obj)
                        end
                    end
                    break
                end
            end
        end)
    end
    
    return foundItems
end

