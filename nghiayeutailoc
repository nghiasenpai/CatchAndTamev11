local espEnabled = false
local espCache = {}
local espUpdateConn = nil

local function getRarityInfo(target)
    local fullStr = target.Name:lower()
    local parentName = target.Parent and target.Parent.Name:lower() or ""
    
    -- Kiểm tra Divine trước (ưu tiên cao nhất)
    if fullStr:find("divine") or parentName:find("divine") then 
        return "DIVINE", Color3.fromRGB(255, 140, 0) -- Cam
    end
    
    -- Kiểm tra Mythical
    if fullStr:find("mythic") or fullStr:find("mythical") or parentName:find("mythic") or parentName:find("mythical") then 
        return "MYTHICAL", Color3.fromRGB(255, 0, 0) -- Đỏ
    end
    
    -- Kiểm tra Boss
    if fullStr:find("boss") or parentName:find("boss") then 
        return "BOSS", Color3.fromRGB(255, 255, 0) -- Vàng
    end
    
    -- Kiểm tra Secret
    if fullStr:find("secret") or parentName:find("secret") then 
        return "SECRET", Color3.fromRGB(255, 0, 128) -- Hồng
    end
    
    -- Kiểm tra Legendary
    if fullStr:find("legendary") or parentName:find("legendary") then 
        return "LEGENDARY", Color3.fromRGB(255, 140, 0) -- Cam
    end
    
    return nil, nil
end

local function clearAllESP()
    for item, espData in pairs(espCache) do
        if espData.Highlight then
            pcall(function() espData.Highlight:Destroy() end)
        end
        if espData.Billboard then
            pcall(function() espData.Billboard:Destroy() end)
        end
    end
    espCache = {}
end

local function applyESP(item)
    if not item or item == LocalPlayer.Character or item:IsDescendantOf(LocalPlayer.Character) then return end
    if Players:GetPlayerFromCharacter(item) then return end
    if not (item:IsA("Model") or item:IsA("BasePart")) then return end

    local rootPart = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChild("HumanoidRootPart") or item:FindFirstChildOfClass("BasePart")) or item
    if not rootPart then return end

    local rareType, rareColor = getRarityInfo(item)
    if not rareType then return end

    if espCache[item] then return end

    local tagTitle = "[" .. rareType .. "]\n" .. item.Name

    local hl = Instance.new("Highlight")
    hl.FillColor = rareColor
    hl.OutlineColor = rareColor
    hl.FillTransparency = 0.3
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = item

    local bgui = Instance.new("BillboardGui")
    bgui.Size = UDim2.new(0, 250, 0, 50)
    bgui.AlwaysOnTop = true
    bgui.MaxDistance = 1000
    bgui.Parent = rootPart

    local textLbl = Instance.new("TextLabel", bgui)
    textLbl.Size = UDim2.new(1, 0, 1, 0)
    textLbl.BackgroundTransparency = 1
    textLbl.Font = Enum.Font.GothamBold
    textLbl.TextSize = 14
    textLbl.TextColor3 = rareColor
    textLbl.TextStrokeTransparency = 0
    textLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLbl.Text = tagTitle

    espCache[item] = { Highlight = hl, Billboard = bgui }
end

local function startESP()
    if espUpdateConn then
        espUpdateConn:Disconnect()
    end
    
    espUpdateConn = RunService.Heartbeat:Connect(function()
        if not espEnabled then return end
        
        -- Lấy vị trí người chơi
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        local playerPos = root.Position
        
        -- Quét tất cả model trong workspace
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj ~= LocalPlayer.Character then
                local objRoot = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                if objRoot then
                    -- Chỉ hiện ESP cho các con thú gần người chơi (trong phạm vi 500 studs)
                    local distance = (objRoot.Position - playerPos).Magnitude
                    if distance < 500 then
                        applyESP(obj)
                    end
                end
            end
        end
    end)
end

local function stopESP()
    if espUpdateConn then
        espUpdateConn:Disconnect()
        espUpdateConn = nil
    end
    clearAllESP()
end

AddToggle("👑 ESP Định Vị (Boss Vàng | Mythical Đỏ | Divine Cam)", function(state)
    espEnabled = state
    if state then
        startESP()
    else
        stopESP()
    end
end)

