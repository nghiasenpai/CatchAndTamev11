local speedToggle = AddToggle(MainTab, "🏃 Chạy Nhanh", function(state)
    speedEnabled = state
    showNotification(state and "✅ Đã bật Chạy Nhanh!" or "❌ Đã tắt Chạy Nhanh!")
    
    if speedMaintainConnection then 
        speedMaintainConnection:Disconnect() 
        speedMaintainConnection = nil 
    end
    
    if state then
        speedMaintainConnection = RunService.Heartbeat:Connect(function()
            pcall(function()
                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    local targetSpeed = config.walkSpeed
                    local currentSpeed = hum.WalkSpeed
                    
                    if math.abs(currentSpeed - targetSpeed) > 1 then
                        hum.WalkSpeed = currentSpeed + (targetSpeed - currentSpeed) * 0.2
                    else
                        hum.WalkSpeed = targetSpeed
                    end
                end
            end)
        end)
    else
        local resetConn
        resetConn = RunService.Heartbeat:Connect(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                if hum.WalkSpeed > DEFAULT_SPEED_RESET + 1 then
                    hum.WalkSpeed = hum.WalkSpeed - 3
                elseif hum.WalkSpeed < DEFAULT_SPEED_RESET - 1 then
                    hum.WalkSpeed = hum.WalkSpeed + 3
                else
                    hum.WalkSpeed = DEFAULT_SPEED_RESET
                    if resetConn then resetConn:Disconnect() end
                end
            end
        end)
    end
