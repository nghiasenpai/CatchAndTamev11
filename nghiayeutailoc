-- ANTI-FLING (Chống bị văng + giữ ổn định)
-- ==========================================
local flingConnection = nil

local function enableAntiFling()
    if flingConnection then flingConnection:Disconnect() end
    
    flingConnection = RunService.Heartbeat:Connect(function()
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not root or not hum then return end
            
            -- 1. Chống bị văng xa (fling detection)
            local velocity = root.AssemblyLinearVelocity
            if velocity.Magnitude > 500 then
                root.AssemblyLinearVelocity = velocity.Unit * 500
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
            
            -- 2. Giữ nhân vật không bị ngã
            if hum:GetState() == Enum.HumanoidStateType.FallingDown 
                or hum:GetState() == Enum.HumanoidStateType.Ragdoll then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
            
            -- 3. Chống bị physics đẩy lung tung
            if root.RotVelocity.Magnitude > 50 then
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end)
    end)
end

