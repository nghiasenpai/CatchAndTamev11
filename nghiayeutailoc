local isFlyingToIsland = false
local currentFlyTween = nil
local savedPosition = nil
local speedEnabled = false
local speedMaintainConnection = nil

local function stopFlying()
    isFlyingToIsland = false
    if currentFlyTween then
        pcall(function() currentFlyTween:Cancel() end)
        currentFlyTween = nil
    end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
end

local function flyToExactPosition(targetPos, islandName)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    
    stopFlying()
    isFlyingToIsland = true
    hum.PlatformStand = true
    
    local startPos = root.Position
    local flyHeight = math.max(startPos.Y, targetPos.Y) + config.islandFlyHeight
    local highPoint = Vector3.new(startPos.X, flyHeight, startPos.Z)
    local targetHigh = Vector3.new(targetPos.X, flyHeight, targetPos.Z)
    
    showNotification("🚁 Đang bay đến " .. islandName .. "...")
    
    local tween1 = TweenService:Create(root, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = CFrame.new(highPoint)})
    currentFlyTween = tween1
    tween1:Play()
    
    tween1.Completed:Connect(function()
        if not isFlyingToIsland then return end
        local distance = (targetHigh - highPoint).Magnitude
        local duration = math.clamp(distance / config.islandFlySpeed, 1.5, 5)
        
        local tween2 = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {CFrame = CFrame.new(targetHigh)})
        currentFlyTween = tween2
        tween2:Play()
        
        tween2.Completed:Connect(function()
            if not isFlyingToIsland then return end
            hum.PlatformStand = false
            isFlyingToIsland = false
            root.CFrame = CFrame.new(targetHigh)
            root.AssemblyLinearVelocity = Vector3.new(0, -50, 0)
            showNotification("✅ Đã đến " .. islandName .. "!")
        end)
    end)
end

