-- Hàm tele đến 1 bình xăng và giữ E 3s
local function processFuel(fuelData)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    root.CFrame = CFrame.new(fuelData.Position + Vector3.new(0, 5, 0))
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    task.wait(0.3)
    root.CFrame = CFrame.new(fuelData.Position + Vector3.new(0, 5, 0))
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    task.wait(0.2)
    
    holdEFuel()
    task.wait(3.3)
    
    return true
end

-- Vòng lặp auto bình xăng
local function autoFuelLoop()
    while autoFuelEnabled do
        for i, fuelData in ipairs(fuelList) do
            if not autoFuelEnabled then break end
            showNotification("⛽ Bình Xăng " .. i .. "/" .. #fuelList)
            processFuel(fuelData)
        end
    end
end

