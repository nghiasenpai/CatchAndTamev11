local function setupAntiDetection()
    -- 1. Bảo vệ GUI
    pcall(function()
        if syn and syn.protect_gui then syn.protect_gui(ScreenGui) end
        if protect_gui then protect_gui(ScreenGui) end
        if gethui then ScreenGui.Parent = gethui() end
    end)
    
    -- 2. Random tên GUI
    pcall(function()
        ScreenGui.Name = "UI_" .. tostring(math.random(1000000, 9999999))
    end)
    
    -- 3. Chống getnilinstances
    pcall(function()
        if getnilinstances then
            local oldGetNil = getnilinstances
            getnilinstances = function()
                local instances = oldGetNil()
                local filtered = {}
                for _, inst in pairs(instances) do
                    if inst ~= ScreenGui and inst ~= MainFrame and inst ~= Container 
                       and inst ~= ToggleButton and inst ~= LoadingOverlay then
                        table.insert(filtered, inst)
                    end
                end
                return filtered
            end
        end
    end)
    
    -- 4. Chống getgc
    pcall(function()
        if getgc then
            local oldGetGC = getgc
            getgc = function()
                local objects = oldGetGC()
                local filtered = {}
                for _, obj in pairs(objects) do
                    if obj ~= ScreenGui and obj ~= MainFrame and obj ~= Container 
                       and obj ~= ToggleButton and obj ~= LoadingOverlay then
                        table.insert(filtered, obj)
                    end
                end
                return filtered
            end
        end
    end)
    
    -- 5. Chống getreg
    pcall(function()
        if getreg then
            local oldGetReg = getreg
            getreg = function()
                return {}
            end
        end
    end)
    
    -- 6. Hook Kick
    pcall(function()
        if hookfunction and LocalPlayer.Kick then
            hookfunction(LocalPlayer.Kick, function() end)
        end
    end)
    
    -- 7. Hook __namecall để chống kick
    pcall(function()
        if getrawmetatable and setreadonly then
            local mt = getrawmetatable(game)
            if mt then
                local oldNamecall = mt.__namecall
                setreadonly(mt, false)
                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if (method == "Kick" or method == "kick") and self == LocalPlayer then
                        return
                    end
                    if method == "FireServer" then
                        local args = {...}
                        -- Chống kick qua remote
                        if self.Name:lower():find("kick") or self.Name:lower():find("ban") then
                            return
                        end
                    end
                    return oldNamecall(self, ...)
                end)
                setreadonly(mt, true)
            end
        end
    end)
    
    -- 8. Random delay khi call remote (tránh pattern detection)
    pcall(function()
        if hookfunction and getrawmetatable then
            local mt = getrawmetatable(game)
            if mt and mt.__namecall then
                local oldNamecall = mt.__namecall
                setreadonly(mt, false)
                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if method == "FireServer" or method == "InvokeServer" then
                        -- Random delay 0-10ms để tránh pattern
                        task.wait(math.random() * 0.01)
                    end
                    return oldNamecall(self, ...)
                end)
                setreadonly(mt, true)
            end
        end
    end)
end

