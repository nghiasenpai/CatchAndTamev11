local function CreateTab(name, icon)
    local tabBtn = Instance.new("TextButton", TabBar)
    tabBtn.Size = UDim2.new(1, -10, 0, 40)
    tabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    tabBtn.Text = icon .. " " .. name
    tabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 11
    tabBtn.AutoButtonColor = false
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 8)
    
    local scroll = Instance.new("ScrollingFrame", TabContent)
    scroll.Size = UDim2.new(1, -10, 1, -10)
    scroll.Position = UDim2.new(0, 5, 0, 5)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 4
    scroll.ScrollBarImageColor3 = Color3.fromRGB(138, 43, 226)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.ScrollingDirection = Enum.ScrollingDirection.Y
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.Visible = false
    
    local scrollLayout = Instance.new("UIListLayout", scroll)
    scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
    scrollLayout.Padding = UDim.new(0, 6)
    
    local tabData = {
        Button = tabBtn,
        Scroll = scroll,
        Name = name
    }
    
    table.insert(tabs, tabData)
    
    tabBtn.MouseButton1Click:Connect(function()
        for _, tab in ipairs(tabs) do
            tab.Button.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            tab.Button.TextColor3 = Color3.fromRGB(200, 200, 200)
            tab.Scroll.Visible = false
        end
        
        tabBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        scroll.Visible = true
        
        currentTab = tabData
    end)
    
    return scroll
end

